{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "hospital-purchase-system"
      }
    }
  ],
  "services": {
    "hospital-purchase-system": {
      "root": ".",
      "buildCommand": "pip install -r requirements.txt",
      "entrypoint": "run:app"
    }
  }
}
